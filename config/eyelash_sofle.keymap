#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <250>;
};

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <1000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        // TD(0): tap = C, double-tap = M5 — 150 ms tapping term (VIL tap_dance[0])

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp C>, <&m5>;
        };

        td_tilde: td_tilde {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&m0>, <&m_tilde_slash>;
        };

        td_dot: td_dot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp DOT>, <&m_dot_slash>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        // M0: KC_APPLICATION + LSFT(KC_GRAVE) = K_APP then ~

        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K_APP &kp TILDE>;
            label = "M0";
        };

        // M1: KC_APPLICATION + KC_QUOTE = K_APP then '

        m1: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K_APP &kp SQT>;
            label = "M1";
        };

        // M5: KC_APPLICATION + KC_COMMA + KC_C (cedilla)

        m5: m5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K_APP &kp COMMA &kp C>;
            label = "M5";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K_APP &kp GRAVE>;
            label = "M_GRAVE";
        };

        m_tilde_slash: m_tilde_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp FSLH>;
            label = "M_TILDE_SLASH";
        };

        m_dot_slash: m_dot_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp FSLH>;
            label = "M_DOT_SLASH";
        };

        m_caret: m_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp K_APP &kp CARET>;
            label = "M_CARET";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0 — QWERTY + home row mods (Portuguese text)
        // Compose: td_tilde, m_grave, td_dot, m1, m_caret (after ?), td0

        qwerty {
            bindings = <
&kp PRINTSCREEN  &trans  &trans          &trans            &trans         &trans         &kp UP            &trans     &trans       &trans        &trans           &trans     &kp DELETE
&to 1            &kp Q   &kp W           &kp E             &kp R          &kp T          &kp DOWN          &kp Y      &kp U        &kp I         &kp O            &td_tilde  &m_grave
&kp TAB          &kp A   &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F    &kp G          &kp LEFT          &kp H      &mt RCTRL J  &mt RSHIFT K  &mt RIGHT_ALT L  &kp P      &m1
&kp CAPS         &kp Z   &kp X           &td0              &kp V          &kp B          &kp RIGHT         &kp N      &kp M        &kp COMMA     &td_dot          &kp QMARK  &m_caret
&kp C_MUTE       &trans  &mo 5           &kp K_APP         &mt LGUI BSPC  &lt 2 SPACE    &kp C_PLAY_PAUSE  &kp ENTER  &lt 3 ESC    &mo 4         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "QWERTY";
        };

        // Layer 1 — Colemak + home row mods

        colemak_hrm {
            bindings = <
&trans      &trans  &trans          &trans            &trans         &trans         &trans            &trans     &trans       &trans        &trans           &trans    &trans
&to 0       &kp Q   &kp W           &kp F             &kp P          &kp B          &trans            &kp J      &kp L        &kp U         &kp Y            &kp SEMI  &kp PSCRN
&kp TAB     &kp A   &mt LEFT_ALT R  &mt LEFT_SHIFT S  &mt LCTRL T    &kp G          &trans            &kp M      &mt RCTRL N  &mt RSHIFT E  &mt RIGHT_ALT I  &kp O     &trans
&kp CAPS    &kp Z   &kp X           &td0              &kp D          &kp V          &trans            &kp K      &kp H        &kp COMMA     &kp DOT          &kp FSLH  &trans
&kp C_MUTE  &trans  &mo 5           &trans            &mt LGUI BSPC  &lt 2 SPACE    &kp C_PLAY_PAUSE  &kp ENTER  &lt 3 ESC    &mo 4         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "COLMK-HRM";
        };

        // Layer 2 — Numbers / Navigation
        // Left: numpad 0 col + 7-9 / [LAlt]4-[LCtl]6 / 1-3 | Right: arrow cluster

        numbers {
            bindings = <
&trans  &trans  &trans           &trans             &trans         &trans         &trans  &trans     &trans     &trans  &trans     &trans  &trans
&trans  &kp N0  &kp N7           &kp N8             &kp N9         &trans         &trans  &trans     &trans     &trans  &trans     &trans  &trans
&trans  &kp N0  &mt LEFT_ALT N4  &mt LEFT_SHIFT N5  &mt LCTRL N6   &trans         &trans  &kp LEFT   &kp DOWN   &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp N0  &kp N1           &kp N2             &kp N3         &trans         &trans  &trans     &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans           &trans             &mt LGUI BSPC  &lt 2 SPACE    &trans  &kp ENTER  &lt 3 ESC  &trans  &trans     &trans
            >;

            display-name = "NUMBERS";
        };

        // Layer 3 — Code / terminal / Neovim (hold Esc on base layers)
        // Row1: { [ (  |  ) ] } * ^
        // Row2: + - = / %  |  : ; " ' `
        // Row3: @ # $ _ \  |  | & < >

        symbols {
            bindings = <
&trans  &trans    &trans            &trans          &trans         &trans         &trans  &trans         &trans                 &trans           &trans             &trans            &trans
&trans  &trans    &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LPAR       &trans         &trans  &trans         &kp RIGHT_PARENTHESIS  &kp RBRC         &kp RIGHT_BRACKET  &kp STAR          &kp CARET
&trans  &kp PLUS  &kp MINUS         &kp EQUAL       &kp SLASH      &kp PERCENT    &trans  &kp SEMICOLON  &kp COLON              &kp DQT          &kp SQT            &kp GRAVE         &trans
&trans  &kp AT    &kp HASH          &kp DLLR        &kp UNDER      &kp BSLH       &trans  &kp PIPE       &kp AMPS               &kp EXCLAMATION  &kp LESS_THAN      &kp GREATER_THAN  &trans
&trans  &trans    &trans            &trans          &mt LGUI BSPC  &lt 2 SPACE    &trans  &kp ENTER      &lt 3 ESC              &trans           &trans             &trans
            >;

            display-name = "SYMBOLS";
        };

        // Layer 4 — Functions
        // Left only: F7-F10 / [LAlt]F4-[LCtl]F6 F11 / F1-F3 F12

        functions {
            bindings = <
&trans  &trans  &trans           &trans             &trans         &trans         &trans  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &kp F7           &kp F8             &kp F9         &kp F10        &trans  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &mt LEFT_ALT F4  &mt LEFT_SHIFT F5  &mt LCTRL F6   &kp F11        &trans  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &kp F1           &kp F2             &kp F3         &kp F12        &trans  &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans           &trans             &mt LGUI BSPC  &lt 2 SPACE    &trans  &kp ENTER  &lt 3 ESC  &trans  &trans  &trans
            >;

            display-name = "FUNCTIONS";
        };

        // Layer 5 — Bluetooth / ZMK utility (hold MO5 on left thumb in layers 0 & 1)

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans       &trans
&bt BT_CLR      &trans        &trans        &trans        &trans        &trans          &mmv MOVE_DOWN   &trans          &trans        &trans        &trans        &trans       &trans
&trans          &out OUT_USB  &out OUT_BLE  &trans        &trans        &trans          &mmv MOVE_LEFT   &trans          &trans        &trans        &trans        &trans       &trans
&trans          &sys_reset    &trans        &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans          &trans        &sys_reset    &soft_off     &bootloader  &trans
&trans          &trans        &trans        &trans        &trans        &trans          &mkp LCLK        &trans          &trans        &trans        &trans        &trans
            >;

            display-name = "BT";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
